//@version=6
// ═══════════════════════════════════════════════════════════════════════
//  BREAKOUT LIEMYO
//  • Mode "Breakout 4H": searah tren harian + tembus rentang 20 bar, keluar di
//    SL 3 ATR atau saat garis trailing berbalik. Diuji di BTCUSDT 4h saja.
//  • Mode "Klasik": BUY / SELL tiap garis trailing ditembus, dengan SL + TP
//  • Mode "Fraszov 5M": top-down ala @fraszov (gold). 4H arah (HH/HL),
//    1H trend, entry 5M dari 5 setup: A false break high/low 1H sebelumnya,
//    B sweep high/low kemarin, C breakout + retest candle 15M pertama London,
//    D pullback 50% candle 1H kuat, E sweep likuiditas + patah struktur 5M.
//    Belum di-backtest.
//  • Sinyal hanya muncul saat candle tutup (tanpa repaint)
//  • Dua zona tipis di swing terakhir tiap sinyal, berhenti saat ditembus
//  • Segitiga kecil = RSI keluar dari jenuh beli / jenuh jual
//  • Panel skor 0–5 dari 7 faktor: HTF, Trend, RSI, MACD, ROC, %B, Volume
// ═══════════════════════════════════════════════════════════════════════
indicator("Breakout Liemyo", shorttitle = "Breakout Liemyo", overlay = true, behind_chart = false, max_boxes_count = 100, max_labels_count = 300, max_lines_count = 50)

// ─────────────── INPUT ───────────────
string G1 = "1. Sinyal Breakout"
int   atrLen    = input.int(14, "Panjang ATR", minval = 1, group = G1)
float atrMult   = input.float(3.0, "Jarak trailing (x ATR)", minval = 0.5, step = 0.1, group = G1)
string ruleMode = input.string("Fraszov 5M", "Aturan sinyal", options = ["Fraszov 5M", "Breakout 4H", "Klasik"], group = G1, tooltip = "Fraszov 5M: top-down 4H/1H/5M dengan 5 setup (grup 6), untuk chart 5m, belum di-backtest. Breakout 4H: aturan hasil backtest BTCUSDT 4h. Klasik: aturan versi pertama, tanpa keunggulan stabil di backtest.")
int   donLen    = input.int(20, "Rentang breakout (bar)", minval = 2, group = G1)
bool  useFilter = input.bool(true, "Saring dengan skor panel", group = G1, tooltip = "BUY hanya jika skor >= batas, SELL hanya jika skor <= 5 - batas")
float minScore  = input.float(2.5, "Batas skor", minval = 2.5, maxval = 5.0, step = 0.25, group = G1)

string G2 = "2. Stop Loss & Take Profit"
float slMultB = input.float(3.0, "SL Breakout 4H (x ATR)", minval = 0.1, step = 0.1, group = G2)
float slMult = input.float(2.0, "SL Klasik (x ATR)", minval = 0.1, step = 0.1, group = G2)
bool  showTpB = input.bool(false, "Tampilkan TP di Breakout 4H", group = G2, tooltip = "Aturan yang diuji tidak memakai TP. Posisi ditutup oleh SL atau saat garis trailing berbalik.")
float tp1R   = input.float(1.0, "TP1 (kelipatan risiko R)", minval = 0.1, step = 0.1, group = G2)
float tp2R   = input.float(2.0, "TP2 (kelipatan risiko R)", minval = 0.2, step = 0.1, group = G2)
bool  showLv = input.bool(true, "Tampilkan garis SL / TP", group = G2)
bool  showEn = input.bool(false, "Tampilkan garis Entry", group = G2)
int   lblGap = input.int(8, "Ujung garis & label dari bar terakhir (bar)", minval = 0, maxval = 100, group = G2)

string G3 = "3. Zona Swing"
bool  showZone = input.bool(true, "Tampilkan zona", group = G3)
int   swingLb  = input.int(20, "Lookback swing (bar)", minval = 2, group = G3)
int   maxZones = input.int(8, "Jumlah zona maksimal", minval = 2, maxval = 40, group = G3)

string G4 = "4. Panel Skor"
bool   showTbl = input.bool(true, "Tampilkan panel", group = G4)
string tblPos  = input.string("Otomatis", "Posisi", options = ["Otomatis", "Kanan atas", "Kanan bawah", "Kiri atas", "Kiri bawah", "Tengah atas"], group = G4, tooltip = "Otomatis: panel di kanan bawah saat harga di separuh atas rentang 150 bar, dan di kanan atas saat harga di separuh bawah")
string tblSize = input.string("Kecil", "Ukuran teks", options = ["Mungil", "Kecil", "Normal"], group = G4)
string htfTf   = input.timeframe("D", "Timeframe HTF Bias", group = G4)

string G5 = "5. Garis & Faktor"
int  fastLen = input.int(21, "EMA cepat", minval = 1, group = G5)
int  slowLen = input.int(55, "EMA lambat", minval = 2, group = G5)
int  rsiLen  = input.int(14, "Panjang RSI", minval = 2, group = G5)
int  rocLen  = input.int(10, "Panjang ROC", minval = 1, group = G5)
int  bbLen   = input.int(20, "Panjang Bollinger", minval = 2, group = G5)
int  volLen  = input.int(14, "Panjang Volume", minval = 2, group = G5)
bool showTri = input.bool(true, "Segitiga RSI jenuh", group = G5)

string G6 = "6. Fraszov 5M"
int    fPiv      = input.int(3, "Pivot struktur 4H / 1H (bar)", minval = 1, group = G6, tooltip = "4H HH+HL = hanya BUY, LH+LL = hanya SELL, campur = tidak trading")
string fAlign    = input.string("Tidak berlawanan", "Syarat trend 1H", options = ["Tidak berlawanan", "Searah 4H"], group = G6)
bool   fUseA     = input.bool(true, "A. False break high/low 1H sebelumnya", group = G6)
bool   fUseB     = input.bool(true, "B. Sweep high/low kemarin", group = G6)
bool   fUseC     = input.bool(true, "C. Breakout + retest candle 15M pertama London", group = G6)
bool   fUseD     = input.bool(true, "D. Pullback 50% candle 1H kuat", group = G6)
bool   fUseE     = input.bool(true, "E. Sweep likuiditas + patah struktur 5M", group = G6)
int    fConfBars = input.int(6, "Batas tunggu konfirmasi (bar)", minval = 1, group = G6)
float  fBodyK    = input.float(1.0, "Candle 1H kuat: body >= x ATR 1H", minval = 0.1, step = 0.1, group = G6)
int    fSwing    = input.int(3, "Pivot swing 5M (bar)", minval = 1, group = G6)
string fLonOpen  = input.session("0800-0815", "Candle 15M pertama London", group = G6)
string fLonWin   = input.session("0815-1200", "Jendela setup London", group = G6)
float  fSlBuf    = input.float(0.2, "Buffer SL di luar invalidasi (x ATR)", minval = 0.0, step = 0.05, group = G6)
float  fSlMin    = input.float(0.5, "SL minimal (x ATR)", minval = 0.1, step = 0.1, group = G6)
float  fSlMax    = input.float(4.0, "SL maksimal (x ATR), lebih jauh = lewati", minval = 0.5, step = 0.1, group = G6)
bool   fShowLv   = input.bool(true, "Tampilkan level 1H, kemarin, London, 50%", group = G6)

// ─────────────── WARNA ───────────────
color cBuy      = #00BCD4
color cSell     = #FF5252
color cStrBuy   = #00897B
color cSoftBuy  = #26A69A
color cHold     = #5D6D7E
color cSoftSell = #D9534F
color cStrSell  = #B71C1C
color cPanel    = #2A2E39
color cText     = #D1D4DC

// ─────────────── TRAILING + GARIS ───────────────
float atrV = ta.atr(atrLen)
[stLine, stDir] = ta.supertrend(atrMult, atrLen)
bool stUp = stDir < 0

float emaFast = ta.ema(close, fastLen)
float emaSlow = ta.ema(close, slowLen)

// ─────────────── 7 FAKTOR (-2 sampai +2) ───────────────
// HTF: memakai bar HTF yang sudah tutup agar tidak repaint
[htfE50, htfE50Prev, htfE200] = request.security(syminfo.tickerid, htfTf, [ta.ema(close, 50)[1], ta.ema(close, 50)[2], ta.ema(close, 200)[1]], lookahead = barmerge.lookahead_on)
int htfRaw = na(htfE50) ? 0 : (close > htfE50 ? 1 : -1) + (htfE50 > htfE50Prev ? 1 : -1) + (na(htfE200) ? 0 : htfE50 > htfE200 ? 1 : -1)
int sHtf = htfRaw >= 3 ? 2 : htfRaw >= 1 ? 1 : htfRaw <= -3 ? -2 : htfRaw <= -1 ? -1 : 0

// Trend: arah EMA + kekuatan ADX
[diP, diM, adxV] = ta.dmi(14, 14)
int  trendDir = emaFast > emaSlow ? 1 : -1
bool trendOk  = (close > emaFast) == (emaFast > emaSlow)
int  sTrend   = adxV < 18 or not trendOk ? 0 : adxV >= 25 ? 2 * trendDir : trendDir

// RSI
float rsiV = ta.rsi(close, rsiLen)
int sRsi = rsiV >= 60 ? 2 : rsiV >= 55 ? 1 : rsiV <= 40 ? -2 : rsiV <= 45 ? -1 : 0

// MACD: histogram dan arahnya
[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
bool macdFlat = math.abs(macdH) < 0.02 * atrV
int sMacd = macdFlat ? 0 : macdH > 0 ? (macdH > macdH[1] ? 2 : 1) : macdH < 0 ? (macdH < macdH[1] ? -2 : -1) : 0

// ROC: perubahan harga dalam satuan ATR
float rocAtr = atrV > 0 ? (close - close[rocLen]) / atrV : 0.0
int sRoc = rocAtr >= 2.0 ? 2 : rocAtr >= 0.75 ? 1 : rocAtr <= -2.0 ? -2 : rocAtr <= -0.75 ? -1 : 0

// Bollinger %B
[bbMid, bbUp, bbLo] = ta.bb(close, bbLen, 2.0)
float pctB = bbUp > bbLo ? (close - bbLo) / (bbUp - bbLo) : 0.5
int sBb = pctB >= 0.85 ? 2 : pctB >= 0.6 ? 1 : pctB <= 0.15 ? -2 : pctB <= 0.4 ? -1 : 0

// Volume: porsi volume naik terhadap total
float volV   = nz(volume)
float volSum = math.sum(volV, volLen)
float upSum  = math.sum(close >= open ? volV : 0.0, volLen)
float upPct  = volSum > 0 ? upSum / volSum : 0.5
int sVol = upPct >= 0.65 ? 2 : upPct >= 0.55 ? 1 : upPct <= 0.35 ? -2 : upPct <= 0.45 ? -1 : 0

// Skor 0–5 (2.5 = netral)
float scoreAvg = (sHtf + sTrend + sRsi + sMacd + sRoc + sBb + sVol) / 7.0
float score    = (scoreAvg + 2.0) * 1.25
int   sVerdict = score >= 3.5 ? 2 : score > 2.75 ? 1 : score <= 1.5 ? -2 : score < 2.25 ? -1 : 0

// ─────────────── FRASZOV 5M ───────────────
// Struktur: HH+HL = 1, LH+LL = -1, campur = 0. Memakai bar HTF yang sudah tutup.
f_structDir(int len) =>
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    var float hA = na
    var float hB = na
    var float lA = na
    var float lB = na
    if not na(ph)
        hB := hA
        hA := ph
    if not na(pl)
        lB := lA
        lA := pl
    int d = na(hB) or na(lB) ? 0 : hA > hB and lA > lB ? 1 : hA < hB and lA < lB ? -1 : 0
    d

f_prevDir(int len) =>
    int d = f_structDir(len)
    d[1]

int dir4h = nz(request.security(syminfo.tickerid, "240", f_prevDir(fPiv), lookahead = barmerge.lookahead_on))
int dir1h = nz(request.security(syminfo.tickerid, "60", f_prevDir(fPiv), lookahead = barmerge.lookahead_on))
bool fBiasUp = dir4h == 1 and (fAlign == "Searah 4H" ? dir1h == 1 : dir1h != -1)
bool fBiasDn = dir4h == -1 and (fAlign == "Searah 4H" ? dir1h == -1 : dir1h != 1)

[pH1, pL1, pO1, pC1, pA1] = request.security(syminfo.tickerid, "60", [high[1], low[1], open[1], close[1], ta.atr(14)[1]], lookahead = barmerge.lookahead_on)
[yH, yL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// A & B: tembus level lalu close kembali ke dalam, lalu candle berikut close melewati ujung candle sweep
f_sweep(float lvlH, float lvlL, int maxBars) =>
    var int   sBar  = na
    var float sExt  = na
    var float sTrig = na
    var int   bBar  = na
    var float bExt  = na
    var float bTrig = na
    int   sig  = 0
    float stop = na
    if not na(sBar) and bar_index > sBar
        if high > sExt
            sBar := na
        else if close < sTrig
            sig  := -1
            stop := sExt
            sBar := na
        else if bar_index - sBar >= maxBars
            sBar := na
    if not na(bBar) and bar_index > bBar
        if low < bExt
            bBar := na
        else if close > bTrig
            sig  := 1
            stop := bExt
            bBar := na
        else if bar_index - bBar >= maxBars
            bBar := na
    if not na(lvlH) and high > lvlH and close < lvlH
        sBar  := bar_index
        sExt  := high
        sTrig := low
    if not na(lvlL) and low < lvlL and close > lvlL
        bBar  := bar_index
        bExt  := low
        bTrig := high
    [sig, stop]

[sigA, stopA] = f_sweep(pH1, pL1, fConfBars)
[sigB, stopB] = f_sweep(yH, yL, fConfBars)

// C: rentang candle 15M pertama London, close di luar, retest bertahan, candle berikut searah
bool inOR  = not na(time(timeframe.period, fLonOpen, "Europe/London"))
bool inWin = not na(time(timeframe.period, fLonWin, "Europe/London"))
var float orH     = na
var float orL     = na
var int   orStage = 0
var int   rtBar   = na
var float rtHi    = na
var float rtLo    = na
if inOR and not inOR[1]
    orH     := high
    orL     := low
    orStage := 0
    rtBar   := na
else if inOR
    orH := math.max(orH, high)
    orL := math.min(orL, low)
int   sigC  = 0
float stopC = na
if inWin and not inOR and not na(orH)
    if orStage == 0
        if close > orH
            orStage := 1
        else if close < orL
            orStage := -1
    else if orStage == 1
        if not na(rtBar) and bar_index > rtBar
            if close > rtHi
                sigC    := 1
                stopC   := rtLo
                orStage := 2
            rtBar := na
        if orStage == 1
            if close < orH
                orStage := 0
            else if low <= orH
                rtBar := bar_index
                rtHi  := high
                rtLo  := low
    else if orStage == -1
        if not na(rtBar) and bar_index > rtBar
            if close < rtLo
                sigC    := -1
                stopC   := rtHi
                orStage := 2
            rtBar := na
        if orStage == -1
            if close > orL
                orStage := 0
            else if high >= orL
                rtBar := bar_index
                rtHi  := high
                rtLo  := low

// D: candle 1H sebelumnya kuat, harga kembali ke 50%-nya dan 5M bertahan
bool  newHour    = ta.change(time("60")) != 0
bool  strongBull = not na(pA1) and pC1 - pO1 >= fBodyK * pA1
bool  strongBear = not na(pA1) and pO1 - pC1 >= fBodyK * pA1
float mid1       = (pH1 + pL1) / 2.0
var bool dUsed = false
if newHour
    dUsed := false
int   sigD  = 0
float stopD = na
if not dUsed and strongBull and low <= mid1 and close > mid1 and close > open
    sigD  := 1
    stopD := math.min(low, low[1])
    dUsed := true
else if not dUsed and strongBear and high >= mid1 and close < mid1 and close < open
    sigD  := -1
    stopD := math.max(high, high[1])
    dUsed := true

// E: sweep swing high/low 5M → close kuat melewati swing lawan → pullback tertahan + rejection
float swPH = ta.pivothigh(high, fSwing, fSwing)
float swPL = ta.pivotlow(low, fSwing, fSwing)
var float lastPH = na
var float lastPL = na
if not na(swPH)
    lastPH := swPH
if not na(swPL)
    lastPL := swPL
int   eWait = fConfBars * 4
var int   eS    = 0
var int   eSBar = na
var float eSExt = na
var float eSLvl = na
var float eSPb  = na
var int   eB    = 0
var int   eBBar = na
var float eBExt = na
var float eBLvl = na
var float eBPb  = na
int   sigE  = 0
float stopE = na
// sisi SELL
if eS == 2
    eSPb := math.max(eSPb, high)
    if close > eSLvl or bar_index - eSBar > eWait
        eS := 0
    else if high >= eSLvl - 0.25 * atrV and close < open
        sigE  := -1
        stopE := eSPb
        eS    := 0
else if eS == 1
    if high > eSExt
        eSExt := high
        eSBar := bar_index
    if not na(lastPL) and close < lastPL and open - close >= 0.5 * atrV
        eS    := 2
        eSLvl := lastPL
        eSBar := bar_index
        eSPb  := high
    else if bar_index - eSBar > eWait
        eS := 0
if eS == 0 and sigE == 0 and not na(lastPH) and high > lastPH
    eS    := 1
    eSExt := high
    eSBar := bar_index
// sisi BUY
if eB == 2
    eBPb := math.min(eBPb, low)
    if close < eBLvl or bar_index - eBBar > eWait
        eB := 0
    else if low <= eBLvl + 0.25 * atrV and close > open and sigE == 0
        sigE  := 1
        stopE := eBPb
        eB    := 0
else if eB == 1
    if low < eBExt
        eBExt := low
        eBBar := bar_index
    if not na(lastPH) and close > lastPH and close - open >= 0.5 * atrV
        eB    := 2
        eBLvl := lastPH
        eBBar := bar_index
        eBPb  := low
    else if bar_index - eBBar > eWait
        eB := 0
if eB == 0 and not na(lastPL) and low < lastPL
    eB    := 1
    eBExt := low
    eBBar := bar_index

// Pilih setup pertama yang searah bias 4H/1H
int    fPick = 0
float  fStop = na
string fName = ""
f_ok(int s) =>
    (s == 1 and fBiasUp) or (s == -1 and fBiasDn)
if fUseA and f_ok(sigA)
    fPick := sigA
    fStop := stopA
    fName := "A FB 1H"
else if fUseB and f_ok(sigB)
    fPick := sigB
    fStop := stopB
    fName := "B Kemarin"
else if fUseC and f_ok(sigC)
    fPick := sigC
    fStop := stopC
    fName := "C London"
else if fUseD and f_ok(sigD)
    fPick := sigD
    fStop := stopD
    fName := "D 50% 1H"
else if fUseE and f_ok(sigE)
    fPick := sigE
    fStop := stopE
    fName := "E Sweep"
float fRisk = na
if fPick != 0
    fRisk := math.max(math.abs(close - (fStop - fPick * fSlBuf * atrV)), fSlMin * atrV)
    if fRisk > fSlMax * atrV
        fPick := 0

// ─────────────── POSISI & SINYAL ───────────────
bool  isFras     = ruleMode == "Fraszov 5M"
bool  isBreakout = ruleMode == "Breakout 4H"
float slUse      = isBreakout ? slMultB : slMult

var int   lastSig = 0
var bool  legDone = false
var bool  tOpen   = false
var int   tDir    = 0
var int   tBar    = na
var float enP     = na
var float slP     = na
var float tp1P    = na
var float tp2P    = na
var bool  hit1    = false
var bool  hit2    = false
var bool  hitSl   = false
var string tName  = ""

bool newTp1  = false
bool newTp2  = false
bool newSl   = false
bool exitSig = false

// 1. Kelola posisi yang terbuka. SL didahulukan bila SL dan TP tersentuh di candle yang sama.
if tOpen and bar_index > tBar
    bool slTouch  = tDir == 1 ? low <= slP : high >= slP
    bool tp1Touch = tDir == 1 ? high >= tp1P : low <= tp1P
    bool tp2Touch = tDir == 1 ? high >= tp2P : low <= tp2P
    if isBreakout
        if slTouch
            hitSl := true
            newSl := true
            tOpen := false
            exitSig := true
        else
            if tp1Touch and not hit1
                hit1 := true
                newTp1 := true
            if tp2Touch and not hit2
                hit2 := true
                newTp2 := true
    else
        if slTouch and not hit1
            hitSl := true
            newSl := true
        else
            if tp1Touch and not hit1
                hit1 := true
                newTp1 := true
            if tp2Touch
                hit2 := true
                newTp2 := true
            if slTouch and not hit2
                hitSl := true
                newSl := true
        if hitSl or hit2
            tOpen := false

// 2. Breakout 4H: garis trailing berbalik menutup posisi dan membuka leg baru.
if stDir != stDir[1]
    legDone := false
if isBreakout and tOpen and barstate.isconfirmed and (tDir == 1 ? not stUp : stUp)
    tOpen := false
    exitSig := true

// 3. Sinyal baru
bool regimeUp = not na(htfE50) and not na(htfE200) and close > htfE50 and htfE50 > htfE200
bool regimeDn = not na(htfE50) and not na(htfE200) and close < htfE50 and htfE50 < htfE200
float donHi = ta.highest(high, donLen)[1]
float donLo = ta.lowest(low, donLen)[1]
bool scoreUp = not useFilter or score >= minScore
bool scoreDn = not useFilter or score <= 5.0 - minScore

bool buySig  = false
bool sellSig = false
if barstate.isconfirmed
    if isBreakout
        if not tOpen and not legDone
            buySig  := stUp and regimeUp and close > donHi and scoreUp
            sellSig := not stUp and regimeDn and close < donLo and scoreDn
    else if isFras
        if not tOpen
            buySig  := fPick == 1
            sellSig := fPick == -1
    else
        buySig  := stUp and lastSig != 1 and scoreUp
        sellSig := not stUp and lastSig != -1 and scoreDn

if buySig or sellSig
    lastSig := buySig ? 1 : -1
    legDone := true
    tOpen := true
    tDir  := buySig ? 1 : -1
    tBar  := bar_index
    enP   := close
    float risk = isFras ? fRisk : slUse * atrV
    tName := isFras ? fName : ""
    slP   := close - tDir * risk
    tp1P  := close + tDir * tp1R * risk
    tp2P  := close + tDir * tp2R * risk
    hit1  := false
    hit2  := false
    hitSl := false

bool triUp = showTri and barstate.isconfirmed and ta.crossover(rsiV, 30)
bool triDn = showTri and barstate.isconfirmed and ta.crossunder(rsiV, 70)

// ─────────────── ZONA SWING ───────────────
type Zone
    box  b
    int  side
    bool active = true

var array<Zone> zones = array.new<Zone>()

f_addZone(float top, float bot, int side, int leftBar) =>
    color c = side == 1 ? cBuy : cSell
    box b = box.new(leftBar, top, bar_index + 10, bot, border_color = color.new(c, 35), bgcolor = color.new(c, 80))
    zones.push(Zone.new(b, side, true))
    if zones.size() > maxZones
        Zone old = zones.shift()
        old.b.delete()

float swLow  = ta.lowest(low, swingLb)
float swHigh = ta.highest(high, swingLb)
int   swLowX  = bar_index + ta.lowestbars(low, swingLb)
int   swHighX = bar_index + ta.highestbars(high, swingLb)

if showZone
    for z in zones
        if z.active
            bool broken = z.side == 1 ? close < z.b.get_bottom() : close > z.b.get_top()
            if broken
                z.active := false
                z.b.set_right(bar_index)
            else
                z.b.set_right(bar_index + 10)
    if buySig
        f_addZone(swLow + 0.4 * atrV, swLow, 1, swLowX)
        f_addZone(swLow + 1.2 * atrV, swLow + 0.8 * atrV, 1, swLowX)
    if sellSig
        f_addZone(swHigh, swHigh - 0.4 * atrV, -1, swHighX)
        f_addZone(swHigh - 0.8 * atrV, swHigh - 1.2 * atrV, -1, swHighX)

// ─────────────── PLOT ───────────────
plot(not isFras and stUp ? stLine : na, "Trailing Naik", color = cBuy, linewidth = 2, style = plot.style_linebr)
plot(not isFras and not stUp ? stLine : na, "Trailing Turun", color = cSell, linewidth = 2, style = plot.style_linebr)

bool fLv = isFras and fShowLv
plot(fLv ? pH1 : na, "High 1H sebelumnya", color = color.new(#FFB74D, 35), style = plot.style_stepline)
plot(fLv ? pL1 : na, "Low 1H sebelumnya", color = color.new(#FFB74D, 35), style = plot.style_stepline)
plot(fLv ? yH : na, "High kemarin", color = color.new(#BA68C8, 20), linewidth = 2, style = plot.style_stepline)
plot(fLv ? yL : na, "Low kemarin", color = color.new(#BA68C8, 20), linewidth = 2, style = plot.style_stepline)
plot(fLv and (inOR or inWin) ? orH : na, "London 15M high", color = #FFD54F, linewidth = 2, style = plot.style_linebr)
plot(fLv and (inOR or inWin) ? orL : na, "London 15M low", color = #FFD54F, linewidth = 2, style = plot.style_linebr)
plot(fLv and (strongBull or strongBear) ? mid1 : na, "50% candle 1H kuat", color = color.new(#90CAF9, 10), style = plot.style_linebr)
bgcolor(fLv and inOR ? color.new(#FFD54F, 88) : na, title = "Candle 15M pertama London")
pFast = plot(emaFast, "EMA Cepat", color = emaFast > emaSlow ? color.new(cBuy, 15) : color.new(cSell, 15), linewidth = 2)
pSlow = plot(emaSlow, "EMA Lambat", color = color.new(#9598A1, 45), linewidth = 1)
fill(pFast, pSlow, color = emaFast > emaSlow ? color.new(cBuy, 88) : color.new(cSell, 88), title = "Isi EMA")

plotshape(buySig and not isFras, "BUY", shape.labelup, location.belowbar, cBuy, text = "BUY", textcolor = color.white, size = size.small)
plotshape(sellSig and not isFras, "SELL", shape.labeldown, location.abovebar, cSell, text = "SELL", textcolor = color.white, size = size.small)
if isFras and (buySig or sellSig)
    label.new(bar_index, buySig ? low : high, (buySig ? "BUY\n" : "SELL\n") + tName, yloc = buySig ? yloc.belowbar : yloc.abovebar, style = buySig ? label.style_label_up : label.style_label_down, color = buySig ? cBuy : cSell, textcolor = color.white, size = size.small)
plotshape(isFras and (newSl or newTp2), "Posisi selesai", shape.xcross, location.abovebar, #9598A1, size = size.tiny)
plotshape(exitSig and isBreakout, "EXIT", shape.xcross, location.abovebar, #9598A1, text = "EXIT", textcolor = #9598A1, size = size.tiny)
plotshape(triUp, "RSI keluar jenuh jual", shape.triangleup, location.belowbar, cBuy, size = size.tiny)
plotshape(triDn, "RSI keluar jenuh beli", shape.triangledown, location.abovebar, cSell, size = size.tiny)

// ─────────────── GARIS SL / TP DI KANAN ───────────────
string F = format.mintick

f_newLine(color c) =>
    line.new(na, na, na, na, color = color.new(c, 25), style = line.style_dotted)

f_newLabel(color bg, color c) =>
    label.new(na, na, "", style = label.style_label_right, color = bg, textcolor = c, size = size.small)

var line  lnSl  = f_newLine(cSell)
var line  lnTp1 = f_newLine(cBuy)
var line  lnTp2 = f_newLine(cBuy)
var line  lnEn  = f_newLine(#9598A1)
var label lbSl  = f_newLabel(#4A1F24, cSell)
var label lbTp1 = f_newLabel(#0F3F47, cBuy)
var label lbTp2 = f_newLabel(#0F3F47, cBuy)
var label lbEn  = f_newLabel(#2A2E39, #D1D4DC)

f_level(line l, label b, float p, string t) =>
    int x = bar_index + lblGap
    l.set_xy1(tBar, p)
    l.set_xy2(x, p)
    b.set_xy(x, p)
    b.set_text(t)

if barstate.islast and tDir != 0 and showLv
    f_level(lnSl, lbSl, slP, "SL " + str.tostring(slP, F) + (hitSl ? "  x" : not tOpen ? "  selesai" : ""))
    if not isBreakout or showTpB
        f_level(lnTp1, lbTp1, tp1P, "TP1 " + str.tostring(tp1P, F) + (hit1 ? "  v" : ""))
        f_level(lnTp2, lbTp2, tp2P, "TP2 " + str.tostring(tp2P, F) + (hit2 ? "  v" : ""))
    if showEn
        f_level(lnEn, lbEn, enP, (tDir == 1 ? "BUY " : "SELL ") + str.tostring(enP, F))

// ─────────────── PANEL ───────────────
f_txt(int s) =>
    s >= 2 ? "STRONG BUY" : s == 1 ? "BUY" : s == 0 ? "HOLD" : s == -1 ? "SELL" : "STRONG SELL"

f_col(int s) =>
    s >= 2 ? cStrBuy : s == 1 ? cSoftBuy : s == 0 ? cHold : s == -1 ? cSoftSell : cStrSell

string tSize = tblSize == "Mungil" ? size.tiny : tblSize == "Normal" ? size.normal : size.small
string posA = tblPos == "Kanan bawah" ? position.bottom_right : tblPos == "Kiri atas" ? position.top_left : tblPos == "Kiri bawah" ? position.bottom_left : tblPos == "Tengah atas" ? position.top_center : position.top_right

f_newTable(string pos) =>
    table.new(pos, 2, 13, bgcolor = cPanel, border_color = color.new(#787B86, 50), border_width = 1, frame_color = #787B86, frame_width = 1)

var table tbA = f_newTable(posA)
var table tbB = f_newTable(position.bottom_right)
float rangeMid = (ta.highest(high, 150) + ta.lowest(low, 150)) / 2.0

f_row(table tb, int r, string name, int s) =>
    table.cell(tb, 0, r, name, text_color = cText, bgcolor = cPanel, text_halign = text.align_left, text_size = tSize)
    table.cell(tb, 1, r, f_txt(s), text_color = color.white, bgcolor = f_col(s), text_size = tSize)

if barstate.islast and showTbl
    bool  useB  = tblPos == "Otomatis" and close > rangeMid
    table tb    = useB ? tbB : tbA
    table other = useB ? tbA : tbB
    other.clear(0, 0, 1, 12)
    table.cell(tb, 0, 0, "BREAKOUT LIEMYO", text_color = color.white, bgcolor = cPanel, text_size = tSize == size.tiny ? size.small : size.normal)
    table.cell(tb, 1, 0, str.tostring(score, "0.0") + "/5", text_color = color.white, bgcolor = f_col(sVerdict), text_size = tSize == size.tiny ? size.small : size.normal)
    f_row(tb, 1, "VERDICT", sVerdict)
    f_row(tb, 2, "HTF Bias (" + htfTf + ")", sHtf)
    f_row(tb, 3, "Trend", sTrend)
    f_row(tb, 4, "Momentum RSI", sRsi)
    f_row(tb, 5, "MACD", sMacd)
    f_row(tb, 6, "ROC", sRoc)
    f_row(tb, 7, "Bands %B", sBb)
    f_row(tb, 8, "Volume", sVol)
    table.cell(tb, 0, 9, "Posisi", text_color = cText, bgcolor = cPanel, text_halign = text.align_left, text_size = tSize)
    string posTxt = tOpen ? (tDir == 1 ? "LONG" : "SHORT") + (tName != "" ? " " + tName : "") : "FLAT"
    table.cell(tb, 1, 9, posTxt, text_color = color.white, bgcolor = tOpen ? (tDir == 1 ? cStrBuy : cStrSell) : cHold, text_size = tSize)
    table.cell(tb, 0, 10, "4H Arah", text_color = cText, bgcolor = cPanel, text_halign = text.align_left, text_size = tSize)
    table.cell(tb, 1, 10, dir4h == 1 ? "HH/HL NAIK" : dir4h == -1 ? "LH/LL TURUN" : "CAMPUR", text_color = color.white, bgcolor = dir4h == 1 ? cStrBuy : dir4h == -1 ? cStrSell : cHold, text_size = tSize)
    table.cell(tb, 0, 11, "1H Trend", text_color = cText, bgcolor = cPanel, text_halign = text.align_left, text_size = tSize)
    table.cell(tb, 1, 11, dir1h == 1 ? "NAIK" : dir1h == -1 ? "TURUN" : "CAMPUR", text_color = color.white, bgcolor = dir1h == 1 ? cSoftBuy : dir1h == -1 ? cSoftSell : cHold, text_size = tSize)
    bool offTf = (isBreakout and timeframe.period != "240") or (isFras and timeframe.period != "5")
    string tfTip = isBreakout ? "Aturan Breakout 4H hanya diuji di timeframe 4h" : "Fraszov 5M dibuat untuk chart 5m"
    table.cell(tb, 0, 12, syminfo.ticker, text_color = color.new(cText, 30), bgcolor = cPanel, text_halign = text.align_left, text_size = tSize)
    table.cell(tb, 1, 12, timeframe.period, text_color = offTf ? color.orange : color.new(cText, 30), bgcolor = cPanel, text_size = tSize, tooltip = offTf ? tfTip : "")

// ─────────────── ALERT ───────────────
alertcondition(buySig, "Breakout Liemyo BUY", "BUY {{ticker}} di {{close}} ({{interval}})")
alertcondition(sellSig, "Breakout Liemyo SELL", "SELL {{ticker}} di {{close}} ({{interval}})")
alertcondition(newTp1, "Breakout Liemyo TP1", "TP1 {{ticker}} tersentuh")
alertcondition(newTp2, "Breakout Liemyo TP2", "TP2 {{ticker}} tersentuh")
alertcondition(newSl, "Breakout Liemyo SL", "SL {{ticker}} tersentuh")
alertcondition(exitSig and isBreakout, "Breakout Liemyo EXIT", "EXIT posisi {{ticker}} di {{close}}")

if buySig or sellSig
    string tpTxt = isBreakout and not showTpB ? "" : " | TP1 " + str.tostring(tp1P, F) + " | TP2 " + str.tostring(tp2P, F)
    alert((buySig ? "BUY " : "SELL ") + syminfo.ticker + (tName != "" ? " [" + tName + "]" : "") + " entry " + str.tostring(enP, F) + " | SL " + str.tostring(slP, F) + tpTxt, alert.freq_once_per_bar_close)
if exitSig and isBreakout
    alert("EXIT " + syminfo.ticker + " di " + str.tostring(close, F), alert.freq_once_per_bar_close)
